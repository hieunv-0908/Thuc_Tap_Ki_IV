# ===========================
# FunnyShop MVP – .gitignore
# ===========================

# ---- SECRETS (KHÔNG BAO GIỜ COMMIT) ----
.env
.env.local
.env.*.local
*.secret

# ---- Node / Frontend ----
node_modules/
dist/
dist-ssr/
*.local

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Backend / Java / Gradle ----
backend/build/
backend/.gradle/
backend/out/
backend/*.class
backend/*.jar
backend/*.war
.gradle/
build/
*.class
*.jar
*.war

# ---- IDE / Editor ----
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Docker ----
# Không ignore docker-compose.yml (file cấu hình, không có secret)
# Secret được quản lý qua .env

# ---- Test / Coverage ----
coverage/
.nyc_output/
