# =========================================================
# FunnyShop MVP Frontend – Environment Variables Template
# Copy file này thành .env hoặc .env.local và cấu hình giá trị
# =========================================================

# Chế độ Mock API in-memory (true: dùng Mock API có delay 300-600ms, false: gọi Backend thật)
VITE_USE_MOCK=true

# URL API của Backend Spring Boot (sử dụng khi VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:8080
